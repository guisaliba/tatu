# Environment
NODE_ENV=development
PORT=8000

# Supabase Configuration (get these from your Supabase dashboard)
SUPABASE_PRISMA_USER_PASSWORD=your-prisma-user-password
SUPABASE_POSTGRES_PASSWORD=your-postgres-password
SUPABASE_PROJECT_REF=your-project-reference

# Database URLs (will be interpolated from variables above)
DATABASE_URL="postgresql://prisma.${SUPABASE_PROJECT_REF}:${SUPABASE_PRISMA_USER_PASSWORD}@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:${SUPABASE_POSTGRES_PASSWORD}@db.${SUPABASE_PROJECT_REF}.supabase.co:5432/postgres"

# Application
JWT_SECRET=your-secret-key
CORS_ORIGIN=http://localhost:3000
