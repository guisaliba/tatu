// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ARTIST
  OWNER
}

enum ChargeStatus {
  PENDING
  PAID
  PARTIALLY_PAID
}

enum StudioPaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentModel {
  PERCENTAGE
  FIXED_FEE
  HOURLY
}

enum MessageSender {
  USER
  ASSISTANT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  StudioMembership[]
  appointments Appointment[]
  paymentsMade StudioPayment[]    @relation("ArtistPayments")
  socials      Social[]
  chatSessions ChatSession[]

  @@map("users")
}

model Studio {
  id          String  @id @default(cuid())
  email       String? @unique
  description String? @db.Text

  memberships      StudioMembership[]
  appointments     Appointment[]
  paymentsReceived StudioPayment[]    @relation("StudioPayments")
  chatSessions     ChatSession[]
  socials          Social[]

  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)
  addressId Int     @unique

  @@map("studios")
}

model Address {
  id      Int    @id @default(autoincrement())
  street  String
  city    String
  state   String
  zip     String
  country String

  studio Studio?

  @@map("addresses")
}

model Appointment {
  id          String   @id @default(cuid())
  date        DateTime
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio   Studio @relation(fields: [studioId], references: [id])
  studioId String

  artist   User   @relation(fields: [artistId], references: [id])
  artistId String

  customerCharge CustomerCharge?
  studioPayment  StudioPayment?

  @@map("appointments")
}

model StudioMembership {
  role         UserRole     @default(ARTIST)
  paymentModel PaymentModel
  paymentValue Float

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioId String

  @@id([userId, studioId])
  @@map("studio_memberships")
}

model CustomerCharge {
  id            String       @id @default(cuid())
  totalAmount   Float
  paymentMethod String?
  status        ChargeStatus @default(PENDING)
  paidAt        DateTime?

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId String      @unique

  @@map("customer_charges")
}

model StudioPayment {
  id        String              @id @default(cuid())
  amountDue Float
  status    StudioPaymentStatus @default(PENDING)
  dueDate   DateTime
  paidAt    DateTime?

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId String      @unique

  studio   Studio @relation("StudioPayments", fields: [studioId], references: [id])
  studioId String

  artist   User   @relation("ArtistPayments", fields: [artistId], references: [id])
  artistId String

  @@map("studio_payments")
}

model Social {
  id       String  @id @default(cuid())
  service  String
  username String
  url      String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  studio   Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioId String?

  @@unique([service, username])
  @@map("socials")
}

model ChatSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  studio   Studio @relation(fields: [studioId], references: [id])
  studioId String

  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String        @id @default(cuid())
  content   String        @db.Text
  sender    MessageSender
  createdAt DateTime      @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  @@map("chat_messages")
}
